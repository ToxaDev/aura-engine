// @name     Better Rain
// @author   ixmibrahim (Better Rain), after Martijn Steinrucken — BigWings (Heartfelt); adapted for Aura Engine — https://www.shadertoy.com/view/dslczf
// @about    Rain running down a window with the album's cover behind the glass, out of focus and sharp through every drop (without a cover, the lights of a city at night). The rain grows heavy in the loud parts and light in the quiet ones, every kick lands a new drop on the glass, and the drops catch the light when the highs are busy.
// @license  CC BY-NC-SA 3.0 — adapted from "Better Rain" by ixmibrahim (https://www.shadertoy.com/view/dslczf), a fork of "Heartfelt" by Martijn Steinrucken aka BigWings (https://www.shadertoy.com/view/ltffzl)
//
// @section  "Rain"      "The drops on the glass"
// @param    float  rain      1.0   0.0   2.0   0.01  x   "Rain"          "How much rain is on the glass"
// @param    float  follow    1.0   0.0   1.0   0.01      "Follow the song" "How much the rain follows the song's loudness: 0 steady, 1 heavy in the loud parts and light in the quiet ones"
// @param    float  kickDrops 1.0   0.0   2.0   0.01  x   "Kick drops"    "How big the drop is that each kick lands on the glass"
// @param    float  dropSize  1.0   0.6   1.6   0.01  x   "Drop size"     "How big the running drops are"
// @param    float  fall      1.0   0.3   2.0   0.01  x   "Fall speed"    "How fast the drops run down the glass"
// @param    float  glints    1.0   0.0   2.0   0.01  x   "Glints"        "How much the drops catch the light when the highs are busy"
//
// @section  "Behind the glass"  "What you see through the rain"
// @param    choice behind    0     "Album cover|City lights" "Picture" "The album's cover, or the lights of a city at night (always, when a track has no cover)"
// @param    float  blur      1.0   0.5   1.5   0.01  x   "Blur"          "How out of focus the picture behind the glass is"
// @param    float  tint      1.0   0.0   2.0   0.01  x   "Cold tint"     "The slow drift of the light towards blue"
// @param    float  vignette  1.0   0.0   2.0   0.01  x   "Vignette"      "How much the corners darken"
// @param    float  bright    0.9   0.3   1.5   0.01  x   "Brightness"    "How bright the whole picture is"

// @common
// Heartfelt - by Martijn Steinrucken aka BigWings - 2017
// Email:countfrolic@gmail.com Twitter:@The_ArtOfCode
// License Creative Commons Attribution-NonCommercial-ShareAlike 3.0 Unported License.
// Better Rain - by ixmibrahim (a fork of Heartfelt): "Added wavy droplets and made it faster"
// Adapted for Aura Engine: behind the glass the album's cover (or a city's lights at night) instead of a photo; the
// amount of rain follows the song's slow loudness (the layers of drops fade in and out, their speed stays); a kick
// lands a new drop (pass A keeps the last eight); the drops glint with the highs. No mouse.

#define M_PI 3.14159
#define M_2PI 6.28318
#define S(a, b, t) smoothstep(a, b, t)
const int SLOTS = 8;                       // the kicks' drops kept on the glass

// @pass A  iChannel0=A:nearest:clamp
// The drops the kicks land. Slot k lives in texels (2k … 2k+1, 0 … 1): where on the glass (0 … 1), its age in
// seconds, its size (0 = none). Texels (16 … 17, 0 … 1): the slot last used, the seconds since that landing, the
// kick's level a frame ago, the highs (smoothed) for the glints. Paused, time stands: so do the drops.
float hashA(vec2 p) { vec3 p3 = fract(vec3(p.xyx) * .1031); p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }

void mainImage(out vec4 o, in vec2 fc) {
    ivec2 q = ivec2(fc);
    if (q.y > 1 || q.x > 2 * SLOTS + 1) { o = vec4(0.0); return; }
    vec4 meta = texelFetch(iChannel0, ivec2(2 * SLOTS + 1, 1), 0);
    float dt = min(uDelta, 0.05);
    float h = uLive > 0.5 ? musicHit(0, 0.0) : 0.0;
    bool land = uLive > 0.5 && h - meta.z > 0.3 && meta.y > 0.15 && kickDrops > 0.0;
    meta.y = min(meta.y + dt, 60.0);
    if (land) { meta.x = mod(meta.x + 1.0, float(SLOTS)); meta.y = 0.0; }
    meta.z = h;
    float hi = uLive > 0.5 ? musicTreble(0.0) : 0.0;
    meta.w = max(hi * hi, meta.w * exp(-dt / 0.35));            // the highs: up at once, down over a third of a second
    int k = q.x / 2;
    if (k >= SLOTS) { o = meta; return; }
    vec4 s = texelFetch(iChannel0, ivec2(2 * k + 1, 1), 0);
    s.z = min(s.z + dt, 60.0);
    if (land && k == int(meta.x + 0.5)) {
        float a = hashA(vec2(meta.x * 17.3 + 1.0, fract(uTrackTime * 0.731) * 97.0));
        float b = hashA(vec2(a * 51.7 + 3.1, meta.x + 0.37));
        float c = hashA(vec2(b * 23.9, a * 7.3 + 1.7));
        s = vec4(0.06 + 0.88 * a, 0.12 + 0.8 * b, 0.0, 0.7 + 0.6 * c);
    }
    o = s;
}

// @pass B  iChannel0=A:nearest:clamp
vec3 N13(float p) {
    //  from DAVE HOSKINS
   vec3 p3 = fract(vec3(p) * vec3(.1031,.11369,.13787));
   p3 += dot(p3, p3.yzx + 19.19);
   return fract(vec3((p3.x + p3.y)*p3.z, (p3.x+p3.z)*p3.y, (p3.y+p3.z)*p3.x));
}

vec4 N14(float t) {
	return fract(sin(t*vec4(123., 1024., 1456., 264.))*vec4(6547., 345., 8799., 1564.));
}
float N(float t) {
    return fract(sin(t*12345.564)*7658.76);
}

float Saw(float b, float t) {
	return S(0., b, t)*S(1., b, t);
}

vec2 StaticDropCenter(vec2 id)
{
    return N13(id.x*106.45+id.y*3543.654).xy - 0.5;
}

vec3 rand3(vec2 id)
{
    return N13(id.x*105.45+id.y*3543.654);
}

// https://iquilezles.org/articles/distfunctions2d/
float sdEgg( in vec2 p, in float ra, in float rb )
{
    const float k = sqrt(3.0);

    p.x = abs(p.x);

    float r = ra - rb;

    return ((p.y<0.0)       ? length(vec2(p.x,  p.y    )) - r :
            (k*(p.x+r)<p.y) ? length(vec2(p.x,  p.y-k*r)) :
                              length(vec2(p.x+r,p.y    )) - 2.0*r) - rb;
}

vec2 DropLayer2(vec2 uv, float t, vec2 densityScale) {
    vec2 UV = uv;
    vec2 a = vec2(6., 1.) * densityScale;
    vec2 grid = a*2.;

    vec2 id = floor(uv * grid); // get id of each tile in grid
    float gridFall = N(id.x)/3. + 0.5;
    uv.y += t*gridFall/a.y; // make all drops fall a uniform amount
    id = floor(uv * grid); // get id of falling grid
    float extraDropSpeed = N(id.x);
    uv.y += extraDropSpeed; // shift the grid by a (constant) random vertical amount

    id = floor(uv*grid); // update ID to match the location of the shifted grid
    vec2 st = fract(uv*grid)-vec2(.5, 0); // uvs for each tile, -.5<x<.5 and 0<y<1
    vec3 n = N13(id.x*35.2+id.y*2376.1); // random [0,1]
    float x = n.x-.5; // starting horizontal position [-0.5, 0.5]
    float lambda = UV.y*20.; // wavelength of wiggle
    float wiggle = sin(lambda+sin(lambda)); // shape of wiggle path [-1,1]
    x += wiggle*(.5-abs(x))*(n.z-.5); // to drop position, add wiggle with random range
    x *= .6; // keep away from tile edge
    float ti = fract(t*(gridFall+0.1)+n.z); // time offset so they don't all fall at the same time
    float slowStart = 0.85;
    float y = (Saw(slowStart, ti)-.5)*.9+.5; // falling position, slow start fast end
    vec2 p = vec2(x, y); // drop position

    float dropShape = (ti > slowStart) ? -sin(M_2PI * ti/ (1.-slowStart))*.5 - .5 : 0.;
    float d = sdEgg((st-p)*a.yx, 0., dropShape);// drop-shape distance
    float diameter = N(id.x+id.y)/7.+.2; // should be limited by starting position
    float mainDrop = S(diameter/1.5, .0, d); // draws a drop with diameter

    float r2 = S(1., y, st.y);
    float r = sqrt(r2);
    float cd = abs(st.x-x);
    float thickness = diameter * 0.95;
    float trail = S(thickness*r, 0., cd);
    float trailFront = S(-.02, .02, st.y-y); // above the drop is 1 (where the trail is), below the drop is 0
    trail *= r2*trailFront*0.5;

    y = UV.y;
    float trail2 = S((thickness - 0.15)*r, 0., cd);
    trail2 *= trailFront*n.z;
    float droplets = max(0., (sin(y*(1.-y)*120.)-st.y))*trail2;
    float rndX = N(id.x)/1.5 + 0.5;
    float rndY = N(st.y)/40. + 0.05; // high value adds slight shimmering effect
    y = fract(y*11.*rndX)+(st.y-.5); // create a random grid where the droplets will show up
    float dd = length(st-vec2(x, y)); // circular distance of droplet
    droplets = S(trail2+rndY, 0.0, dd); // droplet positions
    float m = mainDrop + droplets*r*trailFront;

    return vec2(m, trail);
}

float StaticDrops(vec2 uv, float t) {
	uv *= 40.;

    vec2 id = floor(uv);
    vec2 center = StaticDropCenter(id)*0.6;
    vec3 rand = rand3(id);
    uv = fract(uv)-.5;

    float d = length(uv-center.xy);
    float radius = 0.3;
    float drop = S(radius, 0.0, d);

    float fade = Saw(0.10, fract(t + rand.y));
    float intensity = fract(rand.x*27.);

    drop *= fade * intensity;
    return drop;
}

// The kicks' drops (pass A's slots): each lands — grows in 60 ms and sends a ripple out — then stays a while
// and fades. uv: the author's (centred, a screen tall).
float KickDrops(vec2 uv) {
    float m = 0.0;
    for (int k = 0; k < SLOTS; k++) {
        vec4 s = texelFetch(iChannel0, ivec2(2 * k + 1, 1), 0);
        if (s.w <= 0.0) continue;
        vec2 c = (s.xy - 0.5) * vec2(iResolution.x / iResolution.y, 1.0) * min(iResolution.y / 450.0, 1.0);
        float d = length(uv - c);
        float r = 0.026 * s.w * kickDrops;
        if (d > r * 3.2) continue;
        float life = 5.0 + 4.0 * s.w;
        float fade = 1.0 - S(life - 2.0, life, s.z);
        m += S(r, r * 0.2, d / S(0.0, 0.06, s.z + 0.001)) * fade;        // the drop: a lens, grown in 60 ms
        float ring = s.z / 0.25;                                           // the landing's ripple, out to 3 r in 0.25 s
        if (ring < 1.0) m += 0.7 * (1.0 - ring) * S(0.006, 0.0, abs(d - r * (1.0 + 2.0 * ring)));
    }
    return m;
}

vec2 Drops(vec2 uv, float t, float l0, float l1, float l2, float kick) {
    vec2 u = uv / dropSize;
    float s = (StaticDrops(u, t))*l0;
    vec2 m1 = DropLayer2(u, t, vec2(1.))*l1;
    vec2 m2 = DropLayer2(u*1.85, t, vec2(1.))*l2;

    float c = s+m1.x+m2.x+kick;
    c = S(0.3, 1.0, c);

    return vec2(c, m1.y + m2.y);
}

void mainImage( out vec4 fragColor, in vec2 fragCoord )
{
	vec2 uv = (fragCoord.xy-.5*iResolution.xy) / iResolution.y;
    uv *= min(iResolution.y / 450.0, 1.0);              // a small view (the player's band) sees fewer, bigger drops
    float T = iTime;

    float t = T*.2*fall;

    // The amount of rain: the song's slow loudness (the layers of drops fade in and out; nothing changes their
    // speed); nothing playing, or "Follow the song" at 0: the author's slow drift.
    float drift = sin(T*.05)*.3+.7;
    float rainAmount = uLive > 0.5 ? mix(drift, 0.3 + 0.7 * musicEnergy(0.0), follow) : drift;
    rainAmount *= rain;

    float maxBlur = mix(3., 6., clamp(rainAmount, 0.0, 1.0));
    float minBlur = 2.;

    float staticDrops = S(-.5, 1., rainAmount)*2.;
    float layer1 = S(.25, .75, rainAmount);
    float layer2 = S(.0, .5, rainAmount);

    vec2 c = Drops(uv, t, staticDrops, layer1, layer2, KickDrops(uv));
    float focus = mix(maxBlur-c.y, minBlur, S(.1, .2, c.x));

    fragColor = vec4(c, focus, 0.0);
}

// @pass image  iChannel0=B:linear:clamp  iChannel1=A:nearest:clamp  iChannel3=cover:mipmap:clamp
#define USE_POST_PROCESSING

float hashI(vec3 p) { p = fract(p * vec3(.1031, .1030, .0973)); p += dot(p, p.yxz + 33.33); return fract((p.x + p.y) * p.z); }

// Behind the glass without a cover: the lights of a city at night, out of focus — each light a disc that grows (and
// dims, keeping its light) as the blur grows, a little brighter at its rim, in the app's colours.
vec3 CityLights(vec2 uv, float focus) {
    vec2 p = uv * vec2(iResolution.x / iResolution.y, 1.0);
    vec3 col = mix(vec3(0.06, 0.045, 0.07), vec3(0.012, 0.018, 0.04), uv.y);   // the street's glow below, the sky above
    float r = min(0.0025 * exp2(focus * 0.85), 0.07);
    float e = clamp(pow(0.008 / r, 1.3), 0.12, 1.0) * 1.6;
    for (int L = 0; L < 2; L++) {
        float cell = L == 0 ? 0.095 : 0.11;
        vec2 id = floor(p / cell);
        for (int j = -1; j <= 1; j++) {
            for (int i = -1; i <= 1; i++) {
                vec2 cid = id + vec2(i, j);
                float h1 = hashI(vec3(cid, float(L) + 1.0));
                vec2 c = (cid + vec2(hashI(vec3(cid, 7.0 + float(L))), hashI(vec3(cid, 13.0 + float(L))))) * cell;
                if (h1 > 0.62 - 0.5 * clamp(c.y, 0.0, 1.0)) continue;       // fewer lights up in the sky
                float d = length(p - c);
                float disc = S(r, r * 0.86, d) * (1.0 + 0.3 * S(r * 0.6, r * 0.9, d));
                vec3 lc = mix(auraAppPalette(h1 * 1.7 + float(L) * 0.35), vec3(1.0, 0.82, 0.55), 0.35);  // with warm street lamps
                col += lc * disc * e * (0.35 + 0.65 * fract(h1 * 13.7));
            }
        }
    }
    return col;
}

// The cover at a blur (a mip level): a strong blur taken as five samples a level and a half finer — one level
// alone shows its square texels as blocks.
vec3 CoverAt(vec2 cu, float mip) {
    if (mip < 2.5) return textureLod(iChannel3, cu, max(mip, 0.0)).rgb;
    float m = mip - 1.5;
    vec2 px = exp2(m) / max(iChannelResolution[3].xy, vec2(1.0));
    vec3 s = textureLod(iChannel3, cu, m).rgb * 2.0;
    s += textureLod(iChannel3, cu + vec2( 1.2,  0.5) * px, m).rgb;
    s += textureLod(iChannel3, cu + vec2(-0.5,  1.2) * px, m).rgb;
    s += textureLod(iChannel3, cu + vec2(-1.2, -0.5) * px, m).rgb;
    s += textureLod(iChannel3, cu + vec2( 0.5, -1.2) * px, m).rgb;
    return s / 6.0;
}

vec3 Behind(vec2 uv, float focus) {
    if (behind == 0 && uHasCover > 0.5) {
        float asp = iResolution.x / iResolution.y;
        vec2 cu = vec2(uv.x, 0.5 + (uv.y - 0.5) / asp);                   // the cover fills the width
        cu = 1.0 - abs(1.0 - mod(cu, 2.0));                                 // mirrored past its edges (a drop's rim looks far)
        float mip = focus + log2(max(iChannelResolution[3].x, 1.0) / 1024.0); // (the author's photo was 1024 wide)
        return CoverAt(cu, mip);
    }
    return CityLights(uv, focus);
}

void mainImage( out vec4 fragColor, in vec2 fragCoord )
{
    vec2 uv = fragCoord.xy/iResolution.xy;

    vec4 drops = texture(iChannel0, uv);
    vec2 c = drops.xy;
    float focus = drops.z * blur;
    float t = iTime * .2;

    float normalScale = 0.5;
    vec2 e = normalScale / iResolution.xy;
    float cx = texture(iChannel0, uv + e).x;
    float cy = texture(iChannel0, uv + e.yx).x;
    vec2 n = vec2(cx-c.x, cy-c.x);
    n = clamp(n, -0.08, 0.08);                          // (a drop's rim bends the view, not half a screen away)

    vec3 col = Behind(uv+n, focus);

    // The drops catch the light when the highs are busy: a glint on the side of each drop that faces the light.
    float hi = texelFetch(iChannel1, ivec2(2 * SLOTS + 1, 1), 0).w;
    col += vec3(1.0, 0.97, 0.92) * S(0.02, 0.07, dot(n, normalize(vec2(-0.6, 0.8)))) * S(0.3, 0.8, c.x) * hi * glints * 0.8;

    #ifdef USE_POST_PROCESSING
    float colFade = sin(t*.2)*.5+.5;
    col *= mix(vec3(1.), vec3(.8, .9, 1.3), colFade * tint);	// subtle color shift
    col *= 1.-dot(uv-.5, uv-.5) * vignette;						// vignette
    #endif

    col *= bright;
    // the player's band: the picture steps back under the title and the technical lines
    if (uFull < 0.5) col *= mix(1.0, 0.5, S(0.36, 0.62, uv.y));
    fragColor = vec4(col, 1.);
}
