// @name     Neonwave Sunset
// @author   mrange (Neonwave Sunset), adapted for Aura Engine — https://www.shadertoy.com/view/7dtcRj
// @about    A neon road runs to a setting sun under a starry dome. The music's spectrum stands as bars along both sides of the road, the bass by the road and the highs out to the edges, each with a falling peak; every kick lights a row of the grid far down the road that rides in with it and reaches you as the kick sounds; the sun glows brighter in the loud parts, and now and then a strong kick sends a meteor across the sky.
// @license  CC BY-NC-SA 3.0 (its blackbody() carries it; the rest is CC0) — adapted from "Neonwave Sunset" by mrange (CC0), https://www.shadertoy.com/view/7dtcRj; blackbody() by Stephane Cuillerdier (Aiekick), https://www.shadertoy.com/view/Mt3GW2; helpers as the code credits them (Inigo Quilez's and hg_sdf's under MIT, Sam Hocevar's HSV under WTFPL)
//
// @section  "Bars"      "The music's spectrum along both sides of the road"
// @param    float  barHeight  1.0   0.3   2.0   0.01  x   "Height"         "How far a bar reaches with its sound"
// @param    float  curve      2.0   1.0   3.0   0.05  x   "Contrast"       "Higher: only the loud bands reach far"
// @param    float  fall       1.0   0.3   3.0   0.01  x   "Fall speed"     "How quickly a bar drops after its sound"
// @param    bool   peaks      1                             "Peaks"          "A mark that holds each bar's loudest moment, then falls"
// @param    choice order      0     "Bass by the road|Bass at the edges" "Order" "Where the low notes stand"
//
// @section  "Colour"
// @param    choice colours    0     "Neon|Album cover|App|Custom" "Colours" "Where the colours come from"
// @param    color  colourA    #2fd9ff                   "Custom first"   "With Custom: the colour of the sun's top and the grid's cool lines"
// @param    color  colourB    #ff3fb4                   "Custom second"  "With Custom: the colour of the sun's foot, the bars and the warm lines"
// @param    float  bright     1.0   0.4   2.0   0.01  x   "Brightness"     "How bright the whole picture is"
//
// @section  "Road"      "The neon grid and the kicks' light on it"
// @param    float  waves      1.0   0.0   2.0   0.01  x   "Kick light"     "How bright the row of the grid each kick lights"
// @param    float  roadSpeed  1.0   0.3   2.0   0.01  x   "Road speed"     "How fast the road runs towards you"
//
// @section  "Sky"       "The sun, the stars and the dome"
// @param    float  loudGlow   1.0   0.0   2.0   0.01  x   "Loud glow"      "How much brighter the sun glows in the loud parts"
// @param    float  meteors    1.0   0.0   2.0   0.01  x   "Meteors"        "How often a strong kick sends a meteor across the sky"
// @param    float  dome       1.0   0.0   2.0   0.01  x   "Sky grid"       "How bright the lines of the starry dome are"
//
// @section  "Layout"
// @param    float  sunX       0.45  0.0   0.8   0.01      "Sun position"   "Where the sun stands in the player, from the middle to the right (full screen: in the middle)"
// @param    float  horizon    0.0  -0.3   0.4   0.01      "Horizon"        "Where the horizon sits in the player (full screen: as the author framed it)"

// Neonwave Sunset — mrange, https://www.shadertoy.com/view/7dtcRj ("License CC0: Neon Sunset. Code is hackish but I
// thought it looked good enough to share.")
// Adapted for Aura Engine: the picture is the author's, and so is the idea of the music in it — the spectrum as bars
// along the road. Here the bars show the spectrum on the ear's scale (log, 25 Hz – 20 kHz: the bass by the road, the
// highs at the edges) instead of Shadertoy's plain 0 – 11 kHz, and they rise at once and fall at a steady pace, each
// with a peak mark that holds and falls (pass A keeps them from frame to frame). Each kick lights a row of the grid
// far down the road: the light rides in with the grid and reaches you as the kick sounds (the road at distance D
// shows the kick (D − D0) / speed seconds ahead). The sun's glow follows the song's slow loudness. The meteor that
// came every few seconds now comes on a strong kick, now and then. The road's run, the dome's turn and the stars'
// twinkle keep their steady speeds; no beat moves the camera or lights the whole picture.

// @common
const float BANDS = 64.0;                 // the bars' music: this many bands, low to high, in pass A's first row
const float METEOR_S = 3.0;               // a meteor's flight, seconds (the author's period)

// @pass A  iChannel0=A:nearest:clamp
// The bars' music, kept from frame to frame in the first row: for each band (r) its level — taken over its
// neighbours and just around now, rising within ~40 ms, falling at the Fall speed — and (g) its peak, held 0.35 s
// then falling at a steady pace (b: how long it has been held). Texel BANDS keeps the meteor: when it started (the
// scene's clock) and its own random number; a strong kick starts one now and then, when the last has flown.
float hash1(float co) { return fract(sin(co*12.9898) * 13758.5453); }

void mainImage(out vec4 o, in vec2 fc) {
    ivec2 ic = ivec2(fc);
    if (ic.y > 0 || ic.x > int(BANDS)) { o = vec4(0.0); return; }
    vec4 was = texelFetch(iChannel0, ic, 0);
    float dt = min(uDelta, 0.05);
    if (ic.x == int(BANDS)) {
        o = was.w < 0.5 ? vec4(-100.0, 0.0, 0.0, 1.0) : was;
        float rise = musicHit(0, 0.0) - musicHit(0, -0.05);
        float chance = 0.1 * meteors;
        if (uLive > 0.5 && rise > 0.5 && iTime - o.x > METEOR_S + 0.5 && hash1(floor(uTrackTime * 8.0)) < chance)
            o = vec4(iTime, hash1(floor(uTrackTime * 8.0) + 17.3), 0.0, 1.0);
        return;
    }
    float f = (float(ic.x) + 0.5) / BANDS;
    float now = 0.12 + 0.08 * sin(uTime * 0.8 + f * 9.0);   // nothing plays: a slow breath
    if (uLive > 0.5) {
        now = 0.0;
        for (int i = -1; i <= 1; i++) {
            float ff = f + float(i) * 0.6 / BANDS;
            float w = i == 0 ? 2.0 : 1.0;
            now += w * (musicSpectrum(ff, 0.02) + musicSpectrum(ff, 0.0) + musicSpectrum(ff, -0.02));
        }
        now /= 12.0;
    }
    float lv = now > was.r ? mix(was.r, now, 1.0 - exp(-dt / 0.04)) : max(now, was.r * exp(-4.0 * fall * dt));
    float pk = was.g, held = was.b + dt;
    if (lv >= pk) { pk = lv; held = 0.0; }
    else if (held > 0.35) pk = max(lv, pk - 0.8 * fall * dt);
    o = vec4(lv, pk, held, 1.0);
}

// @pass image  iChannel0=A:linear:clamp
// License CC0: Neon Sunset
//  Code is hackish but I thought it looked good enough to share
//  The music from GTA III - RISE FM, the best radio channel in GTA III IMHO
#define LAYERS            5.0
#define PI                3.141592654
#define TAU               (2.0*PI)
#define TIME              iTime
#define TTIME             (TAU*TIME)
#define RESOLUTION        iResolution
#define ROT(a)            mat2(cos(a), sin(a), -sin(a), cos(a))

// License: Unknown, author: nmz (twitter: @stormoid), found: https://www.shadertoy.com/view/NdfyRM
float sRGB(float t) { return mix(1.055*pow(t, 1./2.4) - 0.055, 12.92*t, step(t, 0.0031308)); }
// License: Unknown, author: nmz (twitter: @stormoid), found: https://www.shadertoy.com/view/NdfyRM
vec3 sRGB(in vec3 c) { return vec3 (sRGB(c.x), sRGB(c.y), sRGB(c.z)); }

// License: Unknown, author: Matt Taylor (https://github.com/64), found: https://64.github.io/tonemapping/
vec3 aces_approx(vec3 v) {
  v = max(v, 0.0);
  v *= 0.6f;
  float a = 2.51f;
  float b = 0.03f;
  float c = 2.43f;
  float d = 0.59f;
  float e = 0.14f;
  return clamp((v*(a*v+b))/(v*(c*v+d)+e), 0.0f, 1.0f);
}

// License: Unknown, author: Unknown, found: don't remember
float hash(float co) {
  return fract(sin(co*12.9898) * 13758.5453);
}


// License: Unknown, author: Unknown, found: don't remember
vec2 hash2(vec2 p) {
  p = vec2(dot (p, vec2 (127.1, 311.7)), dot (p, vec2 (269.5, 183.3)));
  return fract(sin(p)*43758.5453123);
}

// License: CC BY-NC-SA 3.0, author: Stephane Cuillerdier - Aiekick/2015 (twitter:@aiekick), found: https://www.shadertoy.com/view/Mt3GW2
vec3 blackbody(float Temp) {
  vec3 col = vec3(255.);
  col.x = 56100000. * pow(Temp,(-3. / 2.)) + 148.;
  col.y = 100.04 * log(Temp) - 623.6;
  if (Temp > 6500.) col.y = 35200000. * pow(Temp,(-3. / 2.)) + 184.;
  col.z = 194.18 * log(Temp) - 1448.6;
  col = clamp(col, 0., 255.)/255.;
  if (Temp < 1000.) col *= Temp/1000.;
  return col;
}

// License: WTFPL, author: sam hocevar, found: https://stackoverflow.com/a/17897228/418488
const vec4 hsv2rgb_K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
vec3 hsv2rgb(vec3 c) {
  vec3 p = abs(fract(c.xxx + hsv2rgb_K.xyz) * 6.0 - hsv2rgb_K.www);
  return c.z * mix(hsv2rgb_K.xxx, clamp(p - hsv2rgb_K.xxx, 0.0, 1.0), c.y);
}
#define HSV2RGB(c)  (c.z * mix(hsv2rgb_K.xxx, clamp(abs(fract(c.xxx + hsv2rgb_K.xyz) * 6.0 - hsv2rgb_K.www) - hsv2rgb_K.xxx, 0.0, 1.0), c.y))

// License: WTFPL, author: sam hocevar, found: https://stackoverflow.com/a/17897228/418488
vec3 rgb2hsv(vec3 c) {
  const vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
  vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
  vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
  float d = q.x - min(q.w, q.y);
  float e = 1.0e-10;
  return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

// ── the colours (Aura Engine) ──
// The author's colours are HSV with hues from green-cyan (0.4) through blue and violet to pink (0.95). "Neon" keeps
// them; the others take only the hue from the cover's colours, the app's or two own (cyan end → the first, pink
// end → the second; between two own colours the hue turns the short way round, so the middle stays vivid) and keep
// his saturation and brightness; a grey cover gives softer colours.
vec3 neon(vec3 c) {
  if (colours == 0) return hsv2rgb(c);
  float x = fract(c.x - 0.4) / 0.55;
  vec3 h;
  if (colours == 3) {
    vec3 a = rgb2hsv(colourA), b = rgb2hsv(colourB);
    float dh = b.x - a.x;
    dh -= floor(dh + 0.5);
    float w = clamp(1.0 - abs(1.0 - mod(x, 2.0)), 0.0, 1.0);
    h = vec3(fract(a.x + dh * w), mix(a.y, b.y, w), 1.0);
  } else {
    h = rgb2hsv(colours == 1 ? auraPalette(0.1 + x * 0.6) : auraAppPalette(x * 0.5));
  }
  return hsv2rgb(vec3(h.x, c.y * mix(0.35, 1.0, clamp(h.y * 1.6, 0.0, 1.0)), c.z));
}

// ── the music (Aura Engine) ──
float NBARS;                              // bars in view on each side, set per frame (from the screen's shape)
const float D_NOW = 50.0;                 // the road's distance where a kick's light is when the kick sounds (the view's foot)

// A band's level and peak (f: 0 low … 1 high, log scale) from pass A.
vec2 bandAt(float f) {
  vec2 r = iChannelResolution[0].xy;
  return texture(iChannel0, vec2((clamp(f, 0.0, 1.0) * (BANDS - 1.0) + 0.5) / r.x, 0.5 / r.y)).rg;
}
// The band bar n (0 by the road, outwards) shows.
float barBand(float n) {
  float s = clamp((n + 0.5) / NBARS, 0.0, 1.0);
  return 0.03 + 0.94 * (order == 0 ? s : 1.0 - s);
}
// A kick's light on the road at distance d ahead: a row of the grid lit far down the road rides in with the grid
// and is at D_NOW as the kick sounds (the road at d shows the kick (d − D_NOW) / speed seconds ahead); only a kick's
// start lights one — its first 20th of a second the bright row, its first quarter second the glow behind.
float roadWave(float d) {
  if (uLive < 0.5) return 0.0;
  float t = (d - D_NOW) / (60.0 * roadSpeed);
  float h = musicHit(0, t);
  float front = max(0.0, h - musicHit(0, t - 0.05));
  float glow = max(0.0, h - musicHit(0, t - 0.25));
  return (front + 0.35 * glow) * (t < 0.0 ? exp(t * 6.0) : 1.0);
}

float tanh_approx(float x) {
//  return tanh(x);
  float x2 = x*x;
  return clamp(x*(27.0 + x2)/(27.0+9.0*x2), -1.0, 1.0);
}

float circle(vec2 p, float r) {
  return length(p) - r;
}

// License: MIT, author: Inigo Quilez, found: https://iquilezles.org/articles/smin
float pmin(float a, float b, float k) {
    float h = clamp( 0.5+0.5*(b-a)/k, 0.0, 1.0 );
    return mix( b, a, h ) - k*h*(1.0-h);
}

// License: MIT OR CC-BY-NC-4.0, author: mercury, found: https://mercury.sexy/hg_sdf/
float mod1(inout float p, float size) {
  float halfsize = size*0.5;
  float c = floor((p + halfsize)/size);
  p = mod(p + halfsize, size) - halfsize;
  return c;
}

// License: MIT OR CC-BY-NC-4.0, author: mercury, found: https://mercury.sexy/hg_sdf/
vec2 mod2(inout vec2 p, vec2 size) {
  vec2 c = floor((p + size*0.5)/size);
  p = mod(p + size*0.5,size) - size*0.5;
  return c;
}

// License: MIT, author: Inigo Quilez, found: https://iquilezles.org/articles/intersectors
float rayPlane(vec3 ro, vec3 rd, vec4 p) {
  return -(dot(ro,p.xyz)+p.w)/dot(rd,p.xyz);
}

vec3 toSpherical(vec3 p) {
  float r   = length(p);
  float t   = acos(p.z/r);
  float ph  = atan(p.y, p.x);
  return vec3(r, t, ph);
}

float sun(vec2 p) {
  const float ch = 0.0125;
  vec2 sp = p;
  float d0 = circle(sp, 0.5);
  float d = d0;
  return d;
}

float segmentx(vec2 p) {
  float d0 = abs(p.y);
  float d1 = length(p);
  return p.x > 0.0 ? d0 : d1;
}

float segmentx(vec2 p, float l) {
  float hl = 0.5*l;
  p.x = abs(p.x);
  float d0 = abs(p.y);
  float d1 = length(p-vec2(hl, 0.0));
  return p.x > hl ? d1 : d0;
}

// The bars: the author's, their lengths from our spectrum (pass A). pk: the peak marks.
float synth(vec2 p, float aa, out float h, out float db, out float pk) {
  const float z = 75.0;
  p.y -= -70.0;
  const float st = 0.04;
  p.x = abs(p.x);
  p.x -= 20.0-3.5;
  p.x += st*20.0;
  p /= z;
  float n = mod1(p.x, st);
  float dib = 1E6;
  const int around = 0;
  pk = 0.0;
  for (int i = -around; i <=around ;++i) {
    vec2 lp = n + float(i) >= 0.0 ? bandAt(barBand(n + float(i))) : vec2(0.0);
    float fft = barHeight*pow(lp.x, curve);
    if (i == 0) h = fft;
    float dibb = segmentx((p-vec2(st*float(i), 0.0)).yx, fft+0.05)-st*0.4;
    dib = min(dib, dibb);
    if (peaks && i == 0 && n >= 0.0) {
      // a short bright mark across the bar at its peak's reach, both ends
      float hp = 0.5*(barHeight*pow(lp.y, curve) + 0.05) + 0.004;
      float dp = max(abs(abs(p.y) - hp) - 0.0015, abs(p.x) - st*0.4);
      pk = smoothstep(aa, -aa, dp*z)*step(lp.x + 0.02, lp.y);
    }
  }

  float d = dib;
  db = abs(p.y)*z;
  return smoothstep(aa, -aa, d*z);
}

vec3 road(vec3 ro, vec3 rd, vec3 nrd, float glare, vec4 pl, out float pt) {
  const float szoom   = 0.5;
  const float bsz     = 25.0;
  const float sm      = 1.0;
  float off = abs(pl.w);
  float t = rayPlane(ro, rd, pl);
  pt = t;

  vec3 p  = ro+rd*t;
  vec3 np = ro+nrd*t;

  vec2 pp   = p.xz;
  vec2 npp  = np.xz;
  vec2 opp  = pp;

  float aa  = length(npp-pp)*sqrt(0.5);
  pp.y += -60.0*roadSpeed*TIME;

  vec3 gcol = vec3(0.0);

  float dr = abs(pp.x)-off;
  vec2 cp = pp;
  mod1(cp.y, 6.0*off);
  vec2 sp = pp;
  sp.x = abs(sp.x);
  mod1(sp.y, off);
  float dcl = segmentx(cp.yx, 1.5*off);
  float dsl = segmentx((sp-vec2(0.95*off, 0.0)).yx, off*0.5);

  vec2 mp = pp;
  mod2(mp, vec2(off*0.5));

  vec2 dp = abs(mp);
  float d = dp.x;
  d = pmin(d, dp.y, sm);
  d = max(d, -dr);
  d = min(d, dcl);
  d = min(d, dsl);
  vec2 s2 = sin(TIME+2.0*p.xz/off);
  float m = mix(0.75, 0.9, tanh_approx(s2.x+s2.y));
  m *= m;
  m *= m;
  m *= m;
  vec3 hsv = vec3(0.4+mix(0.5, 0.0, m), tanh_approx(0.15*mix(30.0, 10.0, m)*d), 1.0);
  float fo = exp(-0.04*max(abs(t)-off*2., 0.0));
  vec3 bcol = neon(hsv);
  // (a kick's light: the lines brighten and a warm glow lies on the road, in a row that rides in with the grid)
  float kw = waves*roadWave(ro.z - p.z);
  float lines = exp(-0.1*mix(30.0, 10.0, m)*d);
  gcol += 2.0*bcol*lines*fo*(1.0 + 3.0*kw);
  gcol += kw*neon(vec3(0.52, 0.45, 1.0))*(0.5 + 3.0*lines)*fo;

  float sh;
  float sdb;
  float spk;
  float sd =synth(opp, aa,sh, sdb, spk)*smoothstep(aa, -aa, -dr);
  spk *= smoothstep(aa, -aa, -dr);
  sh = tanh_approx(sh);
  sdb *= 0.075;
  sdb *= sdb;
  sdb += 0.05;
  vec3 scol = sd*(sdb)*pow(tanh(vec3(0.1)+bcol), mix(vec3(1.0), vec3(1.5, 0.5, 0.5), smoothstep(0.4, 0.5, sh)));
  scol += spk*0.6*sqrt(tanh(vec3(0.1)+bcol));
  gcol += scol;


  gcol = t > 0.0 ? gcol : vec3(0.0);
  return gcol+scol;
}

vec3 stars(vec2 sp, float hh) {
  vec3 col = vec3(0.0);

  const float m = LAYERS;
  hh = tanh_approx(20.0*hh);

  for (float i = 0.0; i < m; ++i) {
    vec2 pp = sp+0.5*i;
    float s = i/(m-1.0);
    vec2 dim  = vec2(mix(0.05, 0.003, s)*PI);
    vec2 np = mod2(pp, dim);
    vec2 h = hash2(np+127.0+i);
    vec2 o = -1.0+2.0*h;
    float y = sin(sp.x);
    pp += o*dim*0.5;
    pp.y *= y;
    float l = length(pp);

    float h1 = fract(h.x*1667.0);
    float h2 = fract(h.x*1887.0);
    float h3 = fract(h.x*2997.0);

    vec3 scol = mix(8.0*h2, 0.25*h2*h2, s)*blackbody(mix(3000.0, 22000.0, h1*h1));

    vec3 ccol = col + exp(-(mix(6000.0, 2000.0, hh)/mix(2.0, 0.25, s))*max(l-0.001, 0.0))*scol;
    ccol *= mix(0.125, 1.0, smoothstep(1.0, 0.99, sin(0.25*TIME+TAU*h.y)));
    col = h3 < y ? ccol : col;
  }

  return col;
}

// The meteor: the author's, now started by a strong kick (pass A keeps when, and its random number).
vec3 meteorite(vec2 sp) {
  const float period = METEOR_S;
  vec4 me = texelFetch(iChannel0, ivec2(int(BANDS), 0), 0);
  float mtime = TIME - me.x;
  if (mtime < 0.0 || mtime > period) return vec3(0.0);
  float h0 = me.y;
  float h1 = fract(1667.0*h0);
  vec2 mp = sp;
  mp.x += -1.0;
  mp.y += -0.5*h1;
  mp.y += PI*0.5;
  mp *= ROT(PI+mix(-PI/4.0, PI/4.0, h0));
  float m = mtime/period;
  mp.x += mix(-1.0, 2.0, m);

  float d0 = length(mp);
  float d1 = segmentx(mp);

  vec3 col = vec3(0.0);

  col += 0.5*exp(-4.0*max(d0, 0.0))*exp(-1000.0*max(d1, 0.0));
  col *= 2.0*neon(vec3(0.8, 0.5, 1.0));
  float fl = smoothstep(-0.5, 0.5, sin(12.0*TTIME));
  col += mix(1.0, 0.5, fl)*exp(-mix(100.0, 150.0, fl)*max(d0, 0.0));

  return col;
}

vec3 skyGrid(vec2 sp) {
  const float m = 1.0;

  const vec2 dim = vec2(1.0/12.0*PI);
  float y = sin(sp.x);
  vec2 pp = sp;
  vec2 np = mod2(pp, dim*vec2(1.0/floor(1.0/y), 1.0));

  vec3 col = vec3(0.0);

  float d = min(abs(pp.x), abs(pp.y*y));

  float aa = 2.0/RESOLUTION.y;

  col += 0.25*vec3(0.5, 0.5, 1.0)*exp(-2000.0*max(d-0.00025, 0.0));

  return col;
}


vec3 sunset(vec2 sp, vec2 nsp) {
  const float szoom   = 0.5;
  float aa = length(nsp-sp)*sqrt(0.5);
  sp -= vec2(vec2(0.5, -0.5)*PI);
  sp /= szoom;
  sp = sp.yx;
  sp.y += 0.22;
  sp.y = -sp.y;
  float ds = sun(sp)*szoom;

  vec3 bscol = neon(vec3(fract(0.7-0.25*(sp.y)), 1.0, 1.0));
  // (the glow round the sun: brighter in the loud parts — the song's slow loudness)
  float loud = uLive > 0.5 ? 1.0 + loudGlow*0.9*(musicEnergy(0.0) - 0.5) : 1.0;
  vec3 gscol = loud*0.75*sqrt(bscol)*exp(-50.0*max(ds, 0.0));
  vec3 scol = mix(gscol, bscol, smoothstep(aa, -aa, ds));
  return scol;
}

vec3 glow(vec3 ro, vec3 rd, vec2 sp, vec3 lp) {
  float ld = max(dot(normalize(lp-ro), rd),0.0);
  float y = -0.5+sp.x/PI;
  y = max(abs(y)-0.02, 0.0)+0.1*smoothstep(0.5, PI, abs(sp.y));
  float ci = pow(ld, 10.0)*2.0*exp(-25.0*y);
  float h = 0.65;
  vec3 col = neon(vec3(h, 0.75, 0.35*exp(-15.0*y)))+neon(vec3(0.8, 0.75, 0.5))*ci;
  return col;
}



vec3 neonSky(vec3 ro, vec3 rd, vec3 nrd, out float gl) {
  const vec3 lp       = 500.0*vec3(0.0, 0.25, -1.0);
  vec3 skyCol         = neon(vec3(0.8, 0.75, 0.05));


  float glare = pow(abs(dot(rd, normalize(lp))), 20.0);

  vec2 sp   = toSpherical(rd.xzy).yz;
  vec2 nsp  = toSpherical(nrd.xzy).yz;
  vec3 grd  = rd;
  grd.xy *= ROT(0.025*TIME);
  vec2 spp = toSpherical(grd).yz;

  float gm = 1.0/abs(rd.y)*mix(0.005, 2.0, glare);
  vec3 col = skyCol*gm;
  float ig = 1.0-glare;
  col += glow(ro, rd, sp, lp);
  if (rd.y > 0.0) {
    col += sunset(sp, nsp);
    col += stars(sp, 0.0)*ig;
    col += dome*skyGrid(spp)*ig;
    col += meteorite(sp)*ig;
  }
  gl = glare;
  return col;
}

vec3 color(vec3 ro, vec3 rd, vec3 nrd) {
  const float off1  = -20.0;
  const vec4 pl1    = vec4(normalize(vec3(0.0, 1.0, 0.15)), -off1);
  float glare;
  vec3 col = neonSky(ro, rd, nrd, glare);
  if (rd.y < 0.0) {
    float t;
    col += road(ro, rd, nrd, glare, pl1, t);
  }
  return col;
}

void mainImage(out vec4 fragColor, in vec2 fragCoord) {
  vec2 q = fragCoord/RESOLUTION.xy;
  vec2 p = -1.0 + 2.0*q;
  p.x *= RESOLUTION.x/RESOLUTION.y;
  // (in the player's band the view slides: the sun to the right, clear of the title and the technical lines on the
  // left, and the horizon a little higher or lower)
  if (uFull < 0.5) p -= vec2(sunX*RESOLUTION.x/RESOLUTION.y, horizon);
  float aa = 2.0/RESOLUTION.y;
  vec3 ro = vec3(0.0, 0.0, 10.0);
  vec3 la = vec3(0.0, 2.0, 0.0);
  vec3 up = vec3(0.0, 1.0, 0.0);

  vec3 ww = normalize(la - ro);
  vec3 uu = normalize(cross(up, ww ));
  vec3 vv = normalize(cross(ww,uu));
  const float fov = tan(TAU/6.0);
  // the bars in view on each side: from the road's edge (16 units out) to the edge of the view at their line
  NBARS = clamp((80.0*(RESOLUTION.x/RESOLUTION.y)/fov - 15.7)/3.0, 10.0, 40.0);
  vec2 np = p + vec2(aa);
  vec3 rd = normalize(-p.x*uu + p.y*vv + fov*ww);
  vec3 nrd = normalize(-np.x*uu + np.y*vv + fov*ww);


  vec3 col = vec3(0.1);
  col = color(ro, rd, nrd);
//  col += synth(p, np);
  col *= smoothstep(0.0, 4.0, TIME);
  col = aces_approx(bright*col);
  col = sRGB(col);


  fragColor = vec4(col, 1.0);
}
