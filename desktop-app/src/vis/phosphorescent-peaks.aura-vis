// @name     Phosphorescent Peaks
// @author   mrange & Virgill (Phosphorescent Purple Pixel Peaks), adapted for Aura Engine — https://www.shadertoy.com/view/lX2GzD
// @about    A flight down a valley of glowing glass mountains towards a striped sun, with a road, a city against the sun and bikes on the road. Each kick's light is born inside the far peaks ahead of its sound and rolls towards you through the glass, reaching the nearest peaks as the kick sounds; the city's beam pulses with it and the bikes flash with the hats.
// @license  CC0 — adapted from "MountainBytes: PPPP 4KiB Windows" (Phosphorescent Purple Pixel Peaks, a 4 KiB intro for Mountainbytes 2024) by mrange (code) and Virgill (music), https://www.shadertoy.com/view/lX2GzD, https://demozoo.org/productions/338637/ (helpers as the code credits them: Inigo Quilez's and hg_sdf's under MIT)
//
// @section  "Mountains" "The glowing glass peaks"
// @param    float  kickLight  1.0   0.0   2.0   0.01  x   "Kick light"     "How brightly each kick's wave lights the peaks from inside"
// @param    float  lead       1.0   0.3   2.5   0.05  s   "Look-ahead"     "How long before its kick a wave leaves the far peaks"
// @param    float  inner      1.0   0.4   2.0   0.01  x   "Inner glow"     "How much light the glass holds between the kicks"
// @param    bool   snow       1                             "Snow"           "White caps on the high peaks"
//
// @section  "Colour"
// @param    choice colours    0     "Purple|Album cover|App|Custom" "Colours" "Where the colours come from"
// @param    color  colourA    #5a1aff                   "Custom first"   "With Custom: the colour of the sky, the grid and the sun's top"
// @param    color  colourB    #1ab8ff                   "Custom second"  "With Custom: the colour of the light inside the glass and the sun's foot"
// @param    float  bright     1.0   0.4   2.0   0.01  x   "Brightness"     "How bright the whole picture is"
//
// @section  "Road"      "The road, the city and the bikes"
// @param    bool   road       1                             "Road"           "A glowing road down the valley"
// @param    bool   city       1                             "City"           "A city against the sun, its beam pulsing with the kicks"
// @param    bool   bikes      1                             "Bikes"          "Light trails of bikes on the road, flashing with the hats"
//
// @section  "Flight"    "The camera's flight down the valley"
// @param    float  speed      1.0   0.0   2.0   0.01  x   "Speed"          "How fast the camera flies"
// @param    float  sway       1.0   0.0   1.5   0.01  x   "Sway"           "How far the valley winds left and right"
//
// @section  "Layout"
// @param    float  horizon    0.0  -0.4   0.4   0.01      "Horizon"        "Where the horizon sits in the player (full screen: as the authors framed it)"

// Phosphorescent Purple Pixel Peaks — mrange (code) and Virgill (music), a Windows 4 KiB intro for Mountainbytes
// 2024, https://www.shadertoy.com/view/lX2GzD, https://demozoo.org/productions/338637/ (CC0).
// Adapted for Aura Engine: the picture is the authors'; the intro's script is gone. It ran to its own track — a
// 92-second loop of parts (mountains, then the road, then the city and the bikes, then black), a fixed 90-bpm beat
// that lit the mountains' glass and the city, a flash over the whole picture at every part's start and end, and a
// rocket. Here the camera flies on without cuts, the road, the city and the bikes are settings, the flashes and the
// rocket are left out, and the beat is the song's kicks: each kick's light is born inside the far peaks `Look-ahead`
// seconds before it sounds (the glass at distance d shows the kick (d − NEAR_NOW) / speed seconds ahead) and rolls
// towards you through the glass, reaching the nearest peaks as the kick sounds; the city's beam and the horizon
// pulse with it as it leaves; the bikes' lights flash with the hats. The height maps (passes A and B) are drawn the
// same on every screen (the authors' were stretched to the screen's shape) and made once, not every frame, and the
// march takes bigger steps where it safely can (marked below): the same picture for about two thirds of the cost.

// @common
// ----------------------------------------------
// CC0: Phosphorescent Purple Pixel Peaks
// ----------------------------------------------
//  `----- - --- ---------?\___/?\/zS!?\___/?\/-o
//                mrange & virgill              |
//  `----- - --- ------ -----\___/?\/!?\___/?\/-o
//                                              |
//   release: Phosphorescent Purple Pixel Peaks |
//      type: Windows 4k intro                  |
//      date: 17.02.2024                        |
//     party: Mountainbytes 2024                |
//                                              |
//  code: mrange                                |
//  music: Virgill                              |
//                                              |
// mrange - So, in this release, I set out to   |
// whip up a terrain marcher in a snug 4KiB     |
// space. Started with your usual terrain,      |
// thinking, "Let's give it a synthwave twist." |
// Now, my previous attempts at a synthwave-    |
// style terrain marcher were kinda meh, but    |
// guess what? Lightning struck, and I managed  |
// to sculpt some visually pleasing mountains.  |
//                                              |
// They're not a perfect match for the synthwave|
// vibe, but hey, check out these transparent,  |
// glowing ice cream peaks. Cool, right?        |
//                                              |
// Big shoutout to Virgill for dropping another |
// killer tune that totally catches the vibe.   |
//                                              |
// Oh, and a quick nod to sointu by our main    |
// man Pestis.                                  |
//                                         _  .:!
//  <----- ----- -  -   -     - ----- ----\/----'

#define TIME        iTime
#define RESOLUTION  iResolution

const float
  pi        = acos(-1.)
;

const vec3
  Units     = vec3(0, 1, 1E-2)
;

mat2 rot(float a) {
  float c=cos(a),s=sin(a);
  return mat2(c,s,-s,c);
}

// License: Unknown, author: Unknown, found: don't remember
float hash2(vec2 co) {
  return fract(sin(dot(co.xy ,vec2(12.9898,58.233))) * 13758.5453);
}


// License: MIT, author: Inigo Quilez, found: https://www.shadertoy.com/view/lsf3WH
//  Value noise function
float vnoise(vec2 p) {
 vec2 i = floor(p);
 vec2 f = fract(p);

 vec2 u = f*f*(3.-2.*f);

 float a = hash2(i);
 float b = hash2(i+Units.yx);
 float c = hash2(i+Units.xy);
 float d = hash2(i+Units.yy);

 float m0 = mix(a, b, u.x);
 float m1 = mix(c, d, u.x);
 float m2 = mix(m0, m1, u.y);

 return m2;
}


// License: MIT, author: Inigo Quilez, found: https://iquilezles.org/articles/fbm/
//  Scales and rotates and aggregates multiple layers of value noise
//  to create something that looks like mountains
vec3 fbm(vec2 p, int ii) {
  vec2 np = p;
  vec2 cp = p;
  float nh = 0.0;
  float na = 1.0;
  float ns = 0.0;
  for (int i = 0; i < ii; ++i) {
    nh += na*vnoise(np);
    np += 123.4;
    np *= 2.11*rot(1.);
    ns += na;
    na *= 0.5;
  }

  nh /= ns;

  return vec3(nh);
}

// (Aura Engine) The height maps' domain: the authors' at a 16:9 screen, on every screen — theirs followed the
// screen's shape, so the mountains changed with the window.
vec2 mapDomain(vec2 fragCoord) {
  vec2 q = fragCoord/RESOLUTION.xy;
  return (-1. + 2. * q)*vec2(16.0/9.0, 1.0);
}

// (Aura Engine) A height map is the same every frame: made once for the drawing's size and then kept (the size in
// green and blue, a quarter's precision: a half float holds it exactly).
vec4 keptMap(vec4 was, vec2 fragCoord, int octaves) {
  vec2 key = floor(RESOLUTION.xy/4.);
  return was.a > 0.5 && was.gb == key ? was : vec4(fbm(mapDomain(fragCoord), octaves).x, key, 1.0);
}

// @pass A  iChannel0=A:nearest:clamp
// High resolution FBM
//  Used for normal computation and raymarching of the detailed mountain
void mainImage(out vec4 fragColor, in vec2 fragCoord) {
  fragColor = keptMap(texelFetch(iChannel0, ivec2(fragCoord), 0), fragCoord, 6);
}

// @pass B  iChannel0=B:nearest:clamp
// Low resolution FBM
//  Used for snow normal computation and inner glowing mountains
void mainImage(out vec4 fragColor, in vec2 fragCoord) {
  fragColor = keptMap(texelFetch(iChannel0, ivec2(fragCoord), 0), fragCoord, 4);
}

// @pass image  iChannel0=A:linear:clamp  iChannel1=B:linear:clamp
#define hifbm iChannel0
#define lofbm iChannel1

const float
  tau       = 2.*pi
, max_dist  = 14.
, near_dist = 10.
, tolerance = 1E-3
, eps1      = 1E-1
, path_a    = .2
, path_b    = 3.
, minh      = .5
, maxh      = 2.5
, wl        = .3
, innerAdj  = .25
, ch        = .0175
, stp       = 66.
, lp        = .33*tau/stp
, fof       = log(20.)
, rnd       = 123.4
;

const vec3
  roadGlow   = vec3(1   , .3 , .2)*2E-5
, bikeFlash  = vec3(.5  , .1 , .2)*5E-4
, absorbCol  = -4.*vec3(.5, 2., 1.)
, sunDir     = normalize(vec3(0., .2, -1.))
, upDir      = Units.xyx
;

const vec4
  planet = vec4(1.25,.5,-1,.45)*1E5
;

const int
  lo_max_iter = 7
, hi_max_iter = 90
;

// License: WTFPL, author: sam hocevar, found: https://stackoverflow.com/a/17897228/418488
vec3 hsv2rgb(vec3 c) {
  vec3 p = abs(fract(c.xxx + vec3(1.0, 2.0/3.0, 1.0/3.0)) * 6.0 - 3.0);
  return c.z * mix(vec3(1.0), clamp(p - 1.0, 0.0, 1.0), c.y);
}
vec3 rgb2hsv(vec3 c) {
  const vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
  vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
  vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
  float d = q.x - min(q.w, q.y);
  float e = 1.0e-10;
  return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

// ── the colours (Aura Engine) ──
// The authors' four colours — the sun's top, its foot, the grid's two — or the same light (their saturation and
// brightness) in the hues of the cover's colours, the app's or two own.
vec3 sunCol0, sunCol1, gridCol0, gridCol1, skyCol, innerGlow;
vec3 recolour(vec3 c, float x, bool second) {
  if (colours == 0) return c;
  vec3 h = rgb2hsv(c);
  vec3 k = rgb2hsv(colours == 1 ? auraPalette(x) : colours == 2 ? auraAppPalette(x) : second ? colourB : colourA);
  return hsv2rgb(vec3(k.x, h.y * mix(0.35, 1.0, clamp(k.y * 1.6, 0.0, 1.0)), h.z));
}
void setColours() {
  sunCol0   = recolour(vec3(.3  , .1 , 1), 0.0, false);
  gridCol0  = recolour(vec3(.8  , .1 , 1), 0.25, false);
  sunCol1   = recolour(vec3(.1  , .7 , 1), 0.5, true);
  gridCol1  = recolour(vec3(.1  , .5 , 1), 0.75, true);
  skyCol    = gridCol0/3.;
  innerGlow = sunCol1*8.;
}

// ── the music (Aura Engine) ──
const float NEAR_NOW = 1.5;               // the glass this far ahead shows the kick as it sounds
// A kick's light in the glass at distance d ahead: it leaves the far peaks (max_dist) `lead` seconds before the kick
// and reaches NEAR_NOW as it sounds; nearer than that it has passed.
float kickAt(float d) {
  if (uLive < 0.5) return 0.0;
  return kickLight*musicHit(0, lead*(d - NEAR_NOW)/(max_dist - NEAR_NOW));
}
float g_skyBeat;                          // the kick's light as it leaves the horizon (the city's beam, the horizon)

vec2 segment(vec2 p) {
  float d0 = length(p);
  return vec2(p.y>0.?d0:abs(p.x), d0);
}

// License: MIT, author: Inigo Quilez, found: https://www.iquilezles.org/www/articles/spherefunctions/spherefunctions.htm
float raySphere(vec3 ro, vec3 rd, vec4 sph) {
  vec3 oc = ro - sph.xyz;
  float b = dot(oc, rd);
  float c = dot(oc, oc) - sph.w*sph.w;
  float h = b*b - c;
  return h>0. ? -b - sqrt(h) :  -1.;
}

// Camera path
vec3 cam_path(float z) {
  return vec3(sin(z*path_a)*path_b*sway, 1.-.4*cos(z*lp), -z);
}

// Derivate of Camera path, used to determine which direction camera points in
vec3 dcam_path(float z) {
  return (cam_path(z+eps1) - cam_path(z-eps1))/(2.*eps1);
}

// Derivate of Derivate of Camera path, used to determine camera tilt
vec3 ddcam_path(float z) {
  return (dcam_path(z+eps1) - dcam_path(z-eps1))/(2.*eps1);
}

// License: Unknown, author: Unknown, found: don't remember
float hash1(float co) {
  return fract(sin(co*12.9898) * 13758.5453);
}

// Diffuse lighting
float dif(vec3 n, vec3 ld) {
  return max(dot(n, ld),0.);
}

// Fake fresnel effect (more reflective at "edges")
float fre(vec3 rd, vec3 n, float pwr) {
  return pow(1.+dot(rd,n), pwr);
}

// License: MIT OR CC-BY-NC-4.0, author: mercury, found: https://mercury.sexy/hg_sdf/
float mod1(inout float p, float size) {
  float halfsize = .5*size;
  float c = floor((p + halfsize)/size);
  p = mod(p + halfsize, size) - halfsize;
  return c;
}


// License: MIT, author: Inigo Quilez, found: https://www.iquilezles.org/www/articles/smin/smin.htm
//  Soft max function, used in the sun for example to round the edges
float pmax(float a, float b, float k) {
  float h = clamp(.5+.5*(a-b)/k, 0., 1.);
  return mix(b, a, h) + k*h*(1.-h);
}

// Height function for mountains
float hf(sampler2D sampler, vec2 p) {
  vec3 cam = cam_path(p.y);
  float f = abs(cam.x+p.x);
  // Global height function
  float g = mix(minh, maxh*(.5-.5*cos(lp*p.y)), smoothstep(.3, 2.-.5*sin(lp*p.y), f));
  p *= .125;
  p += .5;
  vec2 n = fract(.5*floor(p));
  p = fract(p);
  p.x = n.x == 0. ? p.x : 1.-p.x;
  p.y = n.y == 0. ? p.y : 1.-p.y;
  // Combine global height function and mountain FBM
  return mix(wl-1E-2, g*texture(sampler, p).x, road ? smoothstep(.06, .12, f) : 1.);
}

// Raymarches against height function
float rayMarch(sampler2D sampler, vec3 ro, vec3 rd, int maxi, float initt, float yadj, float sgn, float wlt, float stp) {
  float t = initt;
  float lastt;

  int i;

  // (Aura Engine) a ray skimming low over the valley may step further (the step-back below catches an overshoot)
  stp *= 1. + .6*(1. - smoothstep(.04, .2, abs(rd.y)));
  for (i = 0; i < maxi; ++i) {
    if (t > max_dist) {
      break;
    }
    vec3 p = ro+rd*t;
    if (p.y < wl) {
      return wlt;
    }
    // (Aura Engine) above every peak and climbing: nothing more to hit
    if (sgn > 0. && rd.y > 0. && p.y > maxh + 0.05) {
      t = max_dist + 1.;
      break;
    }

    float h = hf(sampler, p.xz)-yadj;
    float d = sgn*(p.y - h);

    if (d < tolerance*(1. + 3.*t)) {     // (Aura Engine: a looser hit farther away, where a pixel is wider)
      // If we have an intercept we just step back a bit and tries again
      //  To reduce the potentiel overshoots
      if (stp >= .125) {
        stp *= .5;
        t = lastt;
      } else {
        break;
      }
    }
    lastt = t;

    t += max(stp*d, tolerance);
  }

  return t;
}

vec3 normal(sampler2D sampler, vec2 p) {
   // (Aura Engine) the step at least about a texel of the height map: a small window's map is coarser
   float e = max(Units.z, 10.0/iChannelResolution[0].y);
   return normalize(vec3(
      hf(sampler, p - vec2(e, 0.)) - hf(sampler, p + vec2(e, 0.))
    , 2.*e
    , hf(sampler, p - vec2(0., e)) - hf(sampler, p + vec2(0., e))
   ));
}

float lorayMarch(vec3 ro, vec3 rd, float initt, float yadj, float sgn, float wlt) {
  return rayMarch(lofbm, ro, rd, lo_max_iter, initt, yadj, sgn, wlt, 1.3);   // (Aura Engine: 7 steps of 1.3, not 10 of .9)
}

vec3 lonormal(vec2 p) {
  return normal(lofbm, p);
}

float hirayMarch(vec3 ro, vec3 rd, float initt, float wlt, int maxi, float stp) {
  return rayMarch(hifbm, ro, rd, maxi, initt, 0., 1., wlt, stp);
}

vec3 hinormal(vec2 p) {
  return normal(hifbm, p);
}

float sun(vec2 p) {
  p.y += -.2;
  float d0 = length(p) - .5;
  float d2 = p.y;
  mod1(p.y, ch*6.);
  float d1 = abs(p.y) -  ch;
  return pmax(d0, -max(d1, d2), ch);
}

// The sky
vec3 skyRender(vec3 ro, vec3 rd) {
  vec2 sp   = rd.xy*2.;
  float ds = sun(sp);

  vec3 bscol = mix(sunCol0, sunCol1, clamp(1.4*sp.y, 0., 1.));
  bscol*=sqrt(bscol*2.);

  // The Sun
  vec3 col = 1E-2/max(abs(ds), 1E-2)*bscol;
  col += bscol*smoothstep(3E-3, 0.0, ds);

  float gd = rd.y+5E-3;

  float t = 1.;
  if (city) {
      // The City (its beam pulses as a kick's light leaves the horizon)
      col += 1E-3/max(abs(sp.x*(sp.y*sp.y+1.)), 2E-3)*(0.5+2.*g_skyBeat)*sunCol1;
      if (sp.y < .25) for (float i = 0.; i < 4.; ++i) {    // (Aura Engine: only low in the sky, where they stand)
        vec2 cp = sp;
        cp *= 1.+.1*i;
        float cn = mod1(cp.x, .015);
        float ch = hash1(cn+rnd*i)*smoothstep(32., 4., abs(cn));
        t = min(t, mix((i+1.)*.125, 1., step(.2*ch, cp.y)));
      }
    col *= t;
  }

  float
    si = raySphere(ro, rd, planet)
  ;

  vec3
    spos = ro+rd*si
  , sn = normalize(spos-planet.xyz+Units.xyx*5E3*sin(1E3*spos.y/1E5))
  , sr = reflect(rd, sn)
  ;

  if (si > 0.) {
    // The Planet
    float
        sdif = dif(sn, sunDir)
      , sspe = 4.*pow(dif(sr, sunDir), 80.)*fre(rd, sn, 4.)
      ;
    col = sunCol0*sdif+sunCol1*sspe;
  }

  col *= step(0., gd);
  // The horizon
  col += 1E-2/max(sqrt(abs(gd))*(75E-2*rd.x*rd.x+75E-4), 5E-4*(1.+30.*rd.x*rd.x))*(1.+.3*g_skyBeat)*skyCol;

  return col;
}

// The ground
vec3 groundRender(vec3 rd, vec3 pp, float pt) {

  float
      gfre  = fre(rd, upDir, 1.)
    , rp    = pp.x
    ;
  rp += cam_path(pp.z).x;

  // The grid
  vec2 ggp    = pp.xz;
  float gcf   = .5+.5*(sin(ggp.x)*sin(ggp.y));
  ggp         *= 3.;
  ggp         -= round(ggp);
  ggp         = abs(ggp);
  float ggd   = min(ggp.x, ggp.y) ;

  vec3 gcol = mix(gridCol0, gridCol1, gcf);
  gcol *= sqrt(gcol)*1E-2;

  float fo = exp(-.5*max(pt-2., 0.));
  float sm = .025*smoothstep(.6, 1., gfre)+1E-3;
  float bp = abs(rp)-5E-2;
  float cp = abs(rp)-25E-3;
  float cs = sign(rp);

  vec3 pcol = gcol/max(ggd, sm);
  sm *= 1E-4;
  if (road) {
    // The road
    pcol *= step(0., bp);
    pcol += roadGlow/max((rp*rp), sm)*smoothstep(.25, .5, sin(20.*pp.z));
    pcol += .25/max(bp*bp, sm)*roadGlow;
  }

  float off = pp.z+TIME*3.;
  float noff = mod1(off, 10.);
  float hoff = hash1(noff);
  // (the bikes' lights flash with the hats)
  float ht = uLive > 0.5 ? 0.25 + 0.75*musicHit(2, 0.0) : 0.4;
  off += 3.*cs*(hoff-.5);

  vec2 cp2 = vec2(cp,off);
  if (road && bikes) {
    // The motorbikes
    pcol += step(0., off)/max(cp*cp, sm)*smoothstep(2., 0., off)*(cs > 0. ? roadGlow.xzy : roadGlow.zyx)*.25;
    pcol += ht*ht/max(dot(cp2, cp2), sm)*bikeFlash;
  }
  pcol *= fo;
  return pcol;
}

vec3 sceneRender(vec3 ro, vec3 rd) {
  vec3 sky = skyRender(ro, rd);

  float pt = -(ro.y-wl)/rd.y;
  // Intersect the mountains
  float gt = hirayMarch(ro, rd, 1E-2, pt, hi_max_iter, .9);

  vec3 col = vec3(0);

  float ft = max(gt-near_dist, 0.)/(max_dist-near_dist);
  float fm = exp(-ft*fof);

  vec3 gp = ro+rd*gt;
  if (pt > 0. && pt <= gt) {
    // Hit the ground
    vec3 pp = ro+pt*rd;
    vec3 pr = reflect(rd, upDir);
    float pfre = fre(rd, upDir, 2.);
    // To find the reflection (Aura Engine: a shorter march in bigger steps — the reflection is faint and soft)
    float pgt = hirayMarch(pp, pr, 5E-2, max_dist, 40, 1.5);

    if (pgt < max_dist) {
      pfre *= .125*smoothstep(2., 4., pgt);
    }

    // The ground
    col = groundRender(rd, pp, pt);
    // The reflection
    col += skyRender(pp, pr)*pfre;
  } else if (gt < max_dist) {
    // The mountains (Aura Engine: their normals only here, not for the ground and the sky too)
    vec3 gn = hinormal(gp.xz);
    vec3 sn = lonormal(gp.xz);
    float sdif = dif(sn, sunDir);
    vec3 gr = reflect(rd, gn);
    vec3 grr = refract(rd, gn, 1.-.025);
    vec3 sr = reflect(rd, sn);

    // Ray march the inner mountains
    float nlt = lorayMarch(gp, grr, eps1, innerAdj, 1., max_dist);
    float rpt = -(gp.y-wl)/grr.y;

    // Compute inner grid
    vec3 rpp = gp+grr*rpt;
    vec3 groundCol = groundRender(grr, rpp, rpt+gt);
    vec3 nlp = gp+grr*nlt;

    float gfre = fre(rd, gn, 8.);
    float sfre = fre(rd, sn, 2.);

    float sspe = pow(dif(sr, sunDir), 40.);
    float gspe = pow(dif(gr, sunDir), 100.);
    if (snow && gp.y > mix(.2, .5, .5+.5*sin(gp.z+1.23*gp.x))+.6/max(sqrt(gn.y), .1)) {
      // The snow
      col += sfre*sspe;
      col += sfre*gspe;
      col += sdif*sqrt(sunCol1);
      col += -.125*abs(sn.x*sn.y);
      col += sqrt(skyCol)/sn.y;
    } else {
      if (rpt > 0.) {
        // The inner grid
        col += .5*exp(rpt*absorbCol)*groundCol;
      }

      if (nlt < max_dist) {
        // Raymarch through the inner mountain
        float flt = lorayMarch(nlp, grr, 5E-2, innerAdj, -1., max_dist);
        if (flt >= max_dist) {
          flt = rpt-nlt;
        }

        // The inner glow (the glass holds less light between the kicks; a kick's light passing through it lets more out)
        col = mix(col, innerGlow*exp(max(1.5/inner - .75*kickAt(gt), .3)*nlt*absorbCol), exp(.25*flt)-1.);
      }
      if (gfre > 4E-3) col += gfre*.5*skyRender(gp, gr);   // (Aura Engine: only where the glass reflects enough to see)
    }
  } else {
    // Sky
    col = sky;
  }

  // Apply glow
  col = mix(sky, col, fm);

  return col;
}

vec3 effect(vec2 p) {
  // the camera flies on down the valley at the authors' pace (one unit a second), no cuts; it starts where their
  // second part did, as the mountains rise (the valley is flat for a while every ~200 units, as they made it)
  float pt  = TIME*speed + 66.;
  g_skyBeat = kickAt(max_dist + 1.);
  vec3 ro   = cam_path(pt);
  vec3 dro  = dcam_path(pt);
  vec3 ddro = ddcam_path(pt);
  dro.zy *= rot(-.11);

  vec3 ww = normalize(dro);
  vec3 uu = normalize(cross(upDir+2.*ddro, ww));
  vec3 vv = cross(ww, uu);
  // (in the player's band the view slides up or down: the horizon a little higher or lower)
  float py = p.y - (uFull > 0.5 ? 0. : horizon);
  vec3 rd = normalize(p.x*uu + py*vv + 2.*ww);

  vec3 col = sceneRender(ro, rd);
  col = tanh(bright*col)-3E-2*(length(p)+.125);
  // Fade in when the scene starts
  col *= smoothstep(0., 4., TIME);
  col *= 1.25;
  col = sqrt(max(col, 0.));
  return col;
}

void mainImage( out vec4 fragColor, in vec2 fragCoord) {
  setColours();
  vec2 q = fragCoord/RESOLUTION.xy;
  vec2 p = -1.+2.*q;
  p.x *= RESOLUTION.x/RESOLUTION.y;
  vec3 col = effect(p);
  // (Aura Engine) In the player's band a soft shade behind the title and the technical lines (the left, above the
  // middle) keeps the text readable over the snowy ridges and the horizon.
  if (uFull < 0.5) {
    float yt = 1.0 - q.y;
    col *= 1.0 - 0.6*smoothstep(0.28, 0.40, yt)*smoothstep(0.64, 0.54, yt)*smoothstep(0.68, 0.50, q.x);
  }
  fragColor = vec4(col,1.0);
}
